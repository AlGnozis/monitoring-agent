# Шаблон окружения. Скопируй в .env и заполни значения: cp .env.example .env
# .env в git НЕ попадает (см. .gitignore). Здесь — только плейсхолдеры, без реальных секретов.

# --- GigaChat ---
# Authorization key (Base64 client_id:client_secret из личного кабинета GigaChat API)
GIGACHAT_AUTH_KEY=
# Scope доступа: GIGACHAT_API_PERS (физлица) | GIGACHAT_API_B2B | GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# --- Адаптеры внешних систем ---
# Селектор реализации заявок/писем: mock (по умолчанию, без секретов) | real (задел)
ADAPTERS=mock

# --- Источник событий ---
# fake — детерминированный data/fake_feed.json (по умолчанию) | rss — живой фид через feedparser
SOURCE=fake
# URL RSS-фида (нужен только при SOURCE=rss; для fake — оставить пустым)
FEED_URL=
# Интервал опроса источника поллером, сек
POLL_INTERVAL_SEC=300

# --- Embeddings ---
# Базовый URL standalone embedding-service (E5); клиент обращается к POST {url}/embedding
EMBEDDING_SERVICE_URL=http://embedding-service:8000
